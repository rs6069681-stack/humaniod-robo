# SAFE DEFAULTS: simulation runs, physical motor firmware is NOT contacted.
# After wiring verification and bench testing, switch to HARDWARE_MODE=true
# and SIMULATION_ENABLED=false.
HARDWARE_MODE=false
SIMULATION_ENABLED=true
CAMERA_ENABLED=true
DISPLAY_ENABLED=false

# Use stable /dev/serial/by-id paths after plugging in each ESP32.
MOTOR_ESP32_PORT=/dev/serial/by-id/REPLACE_WITH_MOTOR_ESP32_ID
SENSOR_ESP32_PORT=/dev/serial/by-id/REPLACE_WITH_SENSOR_ESP32_ID
ESP32_BAUDRATE=115200

# Camera and safety configuration
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=15
OBSTACLE_STOP_DISTANCE_M=0.25
SENSOR_STALE_SECONDS=0.75
MAX_SPEED_MPS=0.15
YOLO_MODEL_PATH=
YOLO_CONFIDENCE=0.45

# API: set a long random token before connecting the phone app.
ROBOT_API_HOST=0.0.0.0
ROBOT_API_PORT=8000
ROBOT_API_TOKEN=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Optional OpenAI-compatible LLM endpoint. Leave blank to use offline status answers.
# Example base URL: https://api.openai.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
